VITE_API_URL=http://localhost:4000

# Server-only secrets (never exposed to the browser — no VITE_ prefix).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_SECRET=replace-with-a-long-random-string

# Resend — leave RESEND_API_KEY blank to have codes logged server-side instead
# of emailed (useful for local testing before email is wired up).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Your App <onboarding@resend.dev>

# Telnyx — inbound calling (IVR, routing, voicemail).
# TELNYX_API_KEY issues Call Control commands; TELNYX_PUBLIC_KEY (base64, from
# Portal → Account Settings → Keys & Credentials → Public Key) authenticates
# incoming webhooks. Without the public key webhooks are accepted unverified,
# which is fine while testing and not acceptable in production.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
