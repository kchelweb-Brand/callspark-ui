# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Desktop app build output — regenerated by `npm run dist:*` in desktop/,
# and the installer itself is far too large (100MB+) to live in git; it's
# uploaded straight to R2 instead. Generated icons are rebuilt by `npm run
# icons` from the checked-in brand PNG, so they don't need to be tracked.
desktop/release/
desktop/release2/
desktop/build/icon.ico
desktop/build/icon.icns
desktop/build/icon.png
desktop/*.log

# The native calling engine (baresip.exe + its DLLs) — a compiled binary
# produced by the native-dialer/ build workspace. Too large and
# platform-specific to track; copy it into desktop/resources/baresip before
# running `npm run dist:win`.
desktop/resources/

# native-dialer/ is the local build workspace (vendored C source trees for
# baresip/re/rem, generated machine-specific config, build artifacts) used to
# produce that binary — not part of the shipped product, never tracked.
/native-dialer/

# The free simple desktop app (desktop-basic/) — same build-output story as
# desktop/ above.
desktop-basic/release/
desktop-basic/*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
